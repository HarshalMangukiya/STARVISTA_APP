# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://starvista_user:starvista_password@localhost:5432/starvista_db?schema=public

# Redis Configuration (Optional in development, rate limiting falls back to memory if unset)
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRATION=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=doe8ybkzu
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin (FCM & Firestore Migration)
FIREBASE_PROJECT_ID=starvista-b0d10
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@starvista-b0d10.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# CORS Configuration (comma separated)
CORS_ORIGIN=*
